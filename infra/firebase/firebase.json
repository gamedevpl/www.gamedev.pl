{
  "hosting": {
    "site": "gamedevpl",
    "public": "public",
    "ignore": ["**/.*"],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "gamedev-app",
          "region": "europe-west1"
        }
      }
    ]
  }
}
