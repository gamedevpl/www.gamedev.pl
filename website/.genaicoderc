{
  "rootDir": ".",
  "extensions": [
    ".js",
    ".ts",
    ".jsx",
    ".tsx",
    ".mjs",
    ".mts",
    ".cjs",
    ".json",
    ".md",
    ".css",
    ".scss",
    ".html",
    ".txt",
    ".d.ts",
    ".sass",
    ".less",
    ".module.css",
    ".module.scss"
  ],
  "ignorePaths": [
    "node_modules",
    "build",
    "dist",
    "coverage",
    ".next",
    ".cache",
    "dist",
    ".vite"
  ],
  "lintCommand": "npm run lint"
}