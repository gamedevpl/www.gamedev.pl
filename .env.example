# Environment variables for www.gamedev.pl
#
# EVERY VARIABLE HERE IS OPTIONAL FOR LOCAL DEVELOPMENT.
# `npm install && npm run dev` gives you a working arcade, a playable game, a local
# sign-in and a working creation flow with none of this set. Copy this file to `.env`
# only when you need to exercise something against real services.
#
# See docs/local-development.md.

# --- Games content -----------------------------------------------------------------
# Where the API reads games from when GITHUB_TOKEN is unset. Defaults to a sibling
# `../www.gamedev.pl-games` checkout if you have one, otherwise the fixture games in
# apps/api/fixtures/games-repo.
# GAMES_LOCAL_DIR=../www.gamedev.pl-games

# Production path: a token scoped to the games repo turns off all local fallbacks.
# GITHUB_TOKEN=
# GAMES_REPO=gamedevpl/www.gamedev.pl-games
# GAMES_PUBLISHED_REF=main

# --- Sessions and sign-in ----------------------------------------------------------
# Without these, dev sign-in (POST /api/auth/dev) is the way in; real Google OAuth needs
# a client ID with this origin authorized. SESSION_SECRET falls back to a known dev value.
# SESSION_SECRET=
# SESSION_SECRET_PREV=
# GOOGLE_OAUTH_CLIENT_ID=

# --- Creation flow -----------------------------------------------------------------
# Signs the status tokens that make a build addressable. A local-only default is used
# when unset in development.
# SUBMISSION_TOKEN_SECRET=

# --- Access control ----------------------------------------------------------------
# PRIVATE_BETA=true closes sign-up to the allowlists below. Off by default in dev.
# PRIVATE_BETA=false
# BETA_ALLOWED_UIDS=
# BETA_ALLOWED_EMAILS=
# ADMIN_UIDS=
# DAILY_REFINE_QUOTA=20
# Automation ceiling for bot: accounts — the deploy gate spends one refine per deploy.
# DAILY_REFINE_QUOTA_BOT=200

# --- Remote MCP --------------------------------------------------------------------
# MCP_UI=true turns on MCP Apps views (SEP-1865) on /api/mcp: a ui:// resource registry
# and _meta.ui on the tools that have a view. Off by default, and even when on it only
# ever reaches a client that declared the io.modelcontextprotocol/ui extension — every
# other client sees the same tools/list and initialize result as before.
# MCP_UI=false

# --- Hosting -----------------------------------------------------------------------
# PORT=3001
# HOST=127.0.0.1
# WEB_ORIGIN=https://www.gamedev.pl
# APP_BASE_URL=https://www.gamedev.pl
# CANONICAL_HOST=www.gamedev.pl
# WEB_DIST_DIR=

# --- Optional integrations ---------------------------------------------------------
# All of these degrade to a no-op when unset.
# RESEND_API_KEY=              # transactional email
# VAPID_PUBLIC_KEY=            # web push
# PROJECT_ID=                  # Firestore (production only; dev uses an in-memory store)
# ENABLE_VERTEX_MODERATION=    # content moderation via Vertex
# VERTEX_PROJECT_ID=
# VERTEX_REGION=
# VERTEX_MODEL=
# VERTEX_THINKING_LEVEL=

# --- Seeded dispatch ---------------------------------------------------------------
# A model writes a first draft of the game (round 0) and the coding agent starts from it
# instead of an empty directory. Measured at 3.2-3.8x faster builds with no quality
# regression (ops: llm-seed-spike.md). No flag any more — round 0 runs for every new game
# whenever a games-repo token is set (GAMES_REPO_TOKEN or GITHUB_TOKEN), which a laptop
# has neither of by default. Seeding always fails open — when anything here is missing or
# broken the build dispatches unseeded, exactly as it did before.
#
# The runtime kill switch and provider picker are NOT env vars — they live on the
# creation-limits Firestore document (`seedingMode` / `seedProviderOverride`) so an
# operator can pull them within the TTL, no redeploy. See
# ops: seed-provider-selection-plan.md.
#
# Vertex answers round 0 unconditionally (ambient ADC, same as every other Vertex call
# site) and is the only provider on by default:
# SEED_MODEL=gemini-3.5-flash-lite  # measured faster, cheaper, and more reliable than
#                                    # flash across four genres on the same seeder
# SEED_REFERENCES=3            # reference games in context; 5 cost more for the same result
# SEED_PICK_TIMEOUT_MS=30000
# SEED_GENERATE_TIMEOUT_MS=180000
#
# A second vendor is opt-in: set both its key and its model, then select it from the
# console (or via SEED_PROVIDER as the boot-time default). Absent means unconfigured —
# never selectable, whatever an operator picks.
# SEED_PROVIDER=vertex
# SEED_ANTHROPIC_API_KEY=
# SEED_ANTHROPIC_MODEL=
# SEED_OPENAI_API_KEY=
# SEED_OPENAI_MODEL=
# SEED_META_API_KEY=
# SEED_META_MODEL=
# SEED_META_BASE_URL=https://api.meta.ai/v1
# SEED_OPENROUTER_API_KEY=
# SEED_OPENROUTER_MODEL=google/gemini-3.5-flash-lite  # same pick as Vertex; measured
#                                                       # clean on 4/4 genres via OpenRouter
# SEED_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#
# Generation calls request Vertex's own 65536-token ceiling by default. A vendor/model
# with a lower one needs its own override, or every generate call rejects outright:
# SEED_MAX_OUTPUT_TOKENS=
# SEED_ANTHROPIC_MAX_OUTPUT_TOKENS=
# SEED_OPENAI_MAX_OUTPUT_TOKENS=
# SEED_META_MAX_OUTPUT_TOKENS=
# SEED_OPENROUTER_MAX_OUTPUT_TOKENS=
#
# The pick call's own budget defaults to 2048 — too small for a vendor that always
# reasons and cannot turn it off (Meta Muse Spark; confirmed SP-16, ops:
# seed-provider-selection-plan.md). Meta defaults to 8192 for this reason; override any
# vendor's here, capped by its SEED_*_MAX_OUTPUT_TOKENS above:
# SEED_PICK_MAX_OUTPUT_TOKENS=
# SEED_ANTHROPIC_PICK_MAX_OUTPUT_TOKENS=
# SEED_OPENAI_PICK_MAX_OUTPUT_TOKENS=
# SEED_META_PICK_MAX_OUTPUT_TOKENS=
# SEED_OPENROUTER_PICK_MAX_OUTPUT_TOKENS=
# A compiling seed also becomes a playable "first rough draft" preview on the creator's
# status page (assembled through the same serve pipeline as published games). Drafts
# that fail the in-process bundle check get one model repair round; ones that still
# fail are dispatched to the agent anyway, just never shown to the creator.
