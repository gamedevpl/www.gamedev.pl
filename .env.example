# Environment variables for www.gamedev.pl
#
# EVERY VARIABLE HERE IS OPTIONAL FOR LOCAL DEVELOPMENT.
# `npm install && npm run dev` gives you a working arcade, a playable game, a local
# sign-in and a working creation flow with none of this set. Copy this file to `.env`
# only when you need to exercise something against real services.
#
# See docs/local-development.md.

# --- Games content -----------------------------------------------------------------
# Where the API reads games from when GITHUB_TOKEN is unset. Defaults to a sibling
# `../www.gamedev.pl-games` checkout if you have one, otherwise the fixture games in
# apps/api/fixtures/games-repo.
# GAMES_LOCAL_DIR=../www.gamedev.pl-games

# Production path: a token scoped to the games repo turns off all local fallbacks.
# GITHUB_TOKEN=
# GAMES_REPO=gamedevpl/www.gamedev.pl-games
# GAMES_PUBLISHED_REF=main

# --- Sessions and sign-in ----------------------------------------------------------
# Without these, dev sign-in (POST /api/auth/dev) is the way in; real Google OAuth needs
# a client ID with this origin authorized. SESSION_SECRET falls back to a known dev value.
# SESSION_SECRET=
# SESSION_SECRET_PREV=
# GOOGLE_OAUTH_CLIENT_ID=

# --- Creation flow -----------------------------------------------------------------
# Signs the status tokens that make a build addressable. A local-only default is used
# when unset in development.
# SUBMISSION_TOKEN_SECRET=

# --- Access control ----------------------------------------------------------------
# PRIVATE_BETA=true closes sign-up to the allowlists below. Off by default in dev.
# PRIVATE_BETA=false
# BETA_ALLOWED_UIDS=
# BETA_ALLOWED_EMAILS=
# ADMIN_UIDS=
# DAILY_GENERATION_QUOTA=20

# --- Hosting -----------------------------------------------------------------------
# PORT=3001
# HOST=127.0.0.1
# WEB_ORIGIN=https://www.gamedev.pl
# APP_BASE_URL=https://www.gamedev.pl
# CANONICAL_HOST=www.gamedev.pl
# WEB_DIST_DIR=

# --- Optional integrations ---------------------------------------------------------
# All of these degrade to a no-op when unset.
# RESEND_API_KEY=              # transactional email
# VAPID_PUBLIC_KEY=            # web push
# PROJECT_ID=                  # Firestore (production only; dev uses an in-memory store)
# LLM_PROVIDER=mock            # only "mock" is supported
# ENABLE_VERTEX_MODERATION=    # content moderation via Vertex
# VERTEX_PROJECT_ID=
# VERTEX_REGION=
# VERTEX_MODEL=
# VERTEX_THINKING_LEVEL=
