{
  "version": 1,
  "adapters": [
    {
      "name": "claude",
      "command": "claude",
      "versionFlag": "--version",
      "headless": ["-p", "--verbose", "--permission-mode", "acceptEdits", "--output-format", "stream-json"],
      "events": {
        "flag": "--output-format=stream-json",
        "dialect": "ndjson"
      },
      "budget": {
        "turns": "--max-turns"
      },
      "cwd": "game-dir",
      "exit": {
        "success": [0],
        "failure": [1]
      }
    },
    {
