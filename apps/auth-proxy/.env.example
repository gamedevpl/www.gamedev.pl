# The REAL provider key. Lives here and nowhere else — never in the agent
# container, which processes untrusted prompts and publishes its output.
# ANTHROPIC_API_KEY=

# Shared secret used to sign/verify per-job tokens. Must match the value the
# generator side uses to mint them. Required — the proxy refuses to start
# without it, since any token would otherwise be accepted.
AUTH_PROXY_SECRET=

# Where to forward validated requests.
UPSTREAM_BASE_URL=https://api.anthropic.com

PORT=3002
HOST=127.0.0.1
