{
  "name": "@gamedevpl/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "PORT=3001 tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "contract:games-repo": "tsx scripts/check-games-repo-contract.ts",
    "snapshot:publish": "tsx scripts/publish-snapshot.ts",
    "gate:run": "tsx scripts/run-gate.ts",
    "remix:probe": "tsx scripts/remix-lane-probe.ts",
    "managed:probe": "tsx scripts/managed-probe.ts",
    "managed:agent:apply": "tsx scripts/managed-agent-apply.ts",
    "beta:approve": "tsx scripts/beta-approve.ts",
    "beta:invite": "tsx scripts/beta-invite.ts",
    "beta:invite:backfill": "tsx scripts/beta-invite-backfill.ts",
    "token:mint": "tsx scripts/access-token.ts mint",
    "token:list": "tsx scripts/access-token.ts list",
    "token:revoke": "tsx scripts/access-token.ts revoke",
    "slug:backfill": "tsx scripts/slug-backfill.ts",
    "player:erase": "tsx scripts/erase-player-signals.ts",
    "verify:erase": "tsx scripts/verify-erase-signals.ts",
    "remix:sweep": "tsx scripts/remix-lane-sweep.ts",
    "remix:judge": "tsx scripts/remix-lane-judge.ts",
    "remix:calibrate": "tsx scripts/remix-lane-calibrate.ts"
  },
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "@babel/types": "^8.0.4",
    "@fastify/cookie": "11.1.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/static": "^10.1.2",
    "@fastify/websocket": "^11.3.0",
    "@gamedevpl/contract": "*",
    "@gamedevpl/game-generator": "*",
    "@gamedevpl/zone-core": "*",
    "@google-cloud/firestore": "^8.7.0",
    "diff": "^9.0.0",
    "esbuild": "0.25.12",
    "fastify": "^5.10.0",
    "fastify-rate-limit": "npm:@fastify/rate-limit@^11.1.0",
    "genaicode": "^2.3.0",
    "google-auth-library": "^10.9.0",
    "jose": "^6.2.4",
    "pngjs": "^7.0.0",
    "typescript": "5.9.3",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/pngjs": "^6.0.5",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "tsx": "^4.16.5",
    "vitest": "^3.2.7",
    "ws": "^8.18.0"
  }
}
